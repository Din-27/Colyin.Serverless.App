# ========================================================
# Colyin Environment Configuration Template
# Copy this file to .env before starting the platform
# ========================================================

# Runtime Environment (development | production)
NODE_ENV=production

# Dashboard HTTP Host Port (Default 3050 - avoids standard 3000 collision)
PORT=3050

# Public IP of your server VPS (e.g. 103.123.45.67)
# Leave blank or localhost for local laptop testing
PUBLIC_IP=localhost

# Wildcard domain for auto-generated application URLs
# Example for VPS without domain: 103.123.45.67.sslip.io
# Example for custom domain: apps.yourdomain.com
WILDCARD_DOMAIN=127.0.0.1.sslip.io

# Dashboard public domain (used by Traefik)
PAAS_DOMAIN=localhost

# 64-character Hex Master Key for encrypting sensitive credentials (AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=e5b8719284fa9801c87361abef238914619a87cd5219e8301726a45e90bd67a1

# SQLite database storage path
DATABASE_URL=file:./dev.db

# System alert & email notification settings (Optional)
ADMIN_ALERT_EMAIL=admin@example.com
ACME_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GitHub OAuth integration for private repositories (Optional)
# Create in GitHub: Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
